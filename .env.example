# Configuration de l'environnement Docker Moodle
# Copier ce fichier en .env si vous devez personnaliser les chemins :
# cp .env.example .env

# Chemin vers votre dossier Moodle officiel sur votre machine :
# Exemple macOS / Linux :
# MOODLE_DIR=/Users/votre_nom/moodle-docker/moodle
# Exemple si le dossier moodle est dans le projet :
# MOODLE_DIR=./moodle
MOODLE_DIR=/Users/ecoledecode/moodle-docker/moodle
