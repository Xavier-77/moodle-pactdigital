{{!
    @template core/full_header

    This template renders the header, overridden by theme_pactdigital
    to align action buttons (Catalogue, Mon Espace) on the same horizontal row as Customize.
}}
<header id="page-header" class="header-maxwidth d-print-none mb-3">
    <div class="w-100">
        <div class="d-flex flex-wrap align-items-center gap-2">
            {{#hasnavbar}}
            <div id="page-navbar">
                {{{navbar}}}
            </div>
            {{/hasnavbar}}
            <div class="ms-auto d-flex align-items-center gap-2">
                <a href="/local/pactdigital/catalogue.php"
                   class="pact-nav-catalogue-btn pact-header-action-btn"
                   title="Catalogue des formations PACTDIGITAL-BF">
                    Catalogue
                </a>
                <a href="/local/pactdigital/apprenant.php"
                   class="pact-nav-catalogue-btn pact-nav-apprenant-btn pact-header-action-btn"
                   title="Mon Espace Apprenant">
                    Mon Espace
                </a>
                <a href="/local/pactdigital/formateur.php"
                   class="pact-nav-catalogue-btn pact-nav-formateur-btn pact-header-action-btn"
                   title="Espace Formateur PACTDIGITAL-BF">
                    Espace Formateur
                </a>
                {{{pageheadingbutton}}}
            </div>
            <div id="course-header">
                {{{courseheader}}}
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div class="me-auto d-flex flex-column">
                {{#contextheader}}
                <div>
                    {{{contextheader}}}
                </div>
                {{/contextheader}}
                <div>
                    {{> core/welcome }}
                </div>
            </div>
            <div class="header-actions-container ms-auto" data-region="header-actions-container">
                {{#headeractions}}
                <div class="header-action ms-2">{{{.}}}</div>
                {{/headeractions}}
            </div>
        </div>
    </div>
</header>
