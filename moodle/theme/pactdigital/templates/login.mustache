{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="pact-login-page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div class="fs-officiel">
        <div class="fs-conteneur">
            <span class="fs-officiel-sceau">Site officiel de l'administration burkinabè</span>
            <span class="fs-masque-mobile">MTDPCE — Domaine officiel <code>gov.bf</code></span>
        </div>
    </div>
    <div class="fs-filet"></div>

    <div class="container-fluid p-0 h-100 min-vh-100 d-flex flex-column justify-content-between">
        <div class="row g-0 flex-grow-1 align-items-stretch">

            <!-- COLONNE GAUCHE : IDENTITÉ VISUELLE & INSTITUTIONNELLE -->
            <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between pact-login-branding p-5">
                <!-- En-tête haut (.fs-marque) -->
                <a href="{{{ config.wwwroot }}}" class="fs-marque text-white text-decoration-none">
                    {{#armoiries_url}}
                        <img src="{{armoiries_url}}" alt="Armoiries du Burkina Faso" style="height: 56px; width: auto;">
                    {{/armoiries_url}}
                    <span class="fs-marque-texte">
                        <span class="fs-marque-pays text-white">Burkina Faso</span>
                        <span class="fs-marque-devise" style="color: rgba(255,255,255,0.8);">La Patrie ou la Mort, nous Vaincrons</span>
                        <span class="fs-marque-entite" style="color: rgba(255,255,255,0.85);">Ministère de la Transition Digitale, des Postes et des Communications Électroniques</span>
                    </span>
                </a>

                <!-- Contenu central -->
                <div class="my-auto py-5">
                    <span class="badge px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm" style="background: var(--or-300, #ffed00); color: var(--neutre-900, #211d1a); font-family: var(--police-titre);">
                        🇧🇫 Service Public Numérique
                    </span>
                    <h1 class="display-4 fw-extrabold text-white mb-3" style="font-weight: 800; font-family: var(--police-titre);">
                        PACTDIGITAL-BF
                    </h1>
                    <p class="lead text-white mb-4" style="max-width: 520px; font-size: 1.15rem; line-height: 1.6; opacity: 0.9;">
                        La plateforme nationale d'apprentissage et de certification des compétences numériques pour toutes les citoyennes et tous les citoyens burkinabè.
                    </p>

                    <div class="d-flex flex-column gap-3" style="max-width: 480px;">
                        <div class="d-flex align-items-center gap-3 bg-white bg-opacity-10 p-3 rounded-4 border border-white border-opacity-10">
                            <span class="fs-3">🥉🥈🥇</span>
                            <div class="text-white small">
                                <strong>Parcours certifiants :</strong> Progressez du niveau Bronze jusqu'au niveau Or et valorisez vos acquis professionnels.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 bg-white bg-opacity-10 p-3 rounded-4 border border-white border-opacity-10">
                            <span class="fs-3">💻</span>
                            <div class="text-white small">
                                <strong>Formations pour tous :</strong> Compétences fondamentales, managériales, sectorielles et technologies émergentes.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bas de page gauche -->
                <div class="text-white-50 small border-top border-white border-opacity-10 pt-3">
                    © 2026 Ministère de la Transition Digitale • Tous droits réservés.
                </div>
            </div>

            <!-- COLONNE DROITE : FORMULAIRE DE CONNEXION / INSCRIPTION -->
            <div class="col-lg-6 d-flex flex-column justify-content-center align-items-center p-4 p-md-5 bg-white">
                <div class="pact-login-box w-100" style="max-width: 460px;">
                    <!-- Titre de connexion / inscription -->
                    <div class="text-center mb-4">
                        <h2 class="h3 fw-bold text-dark mb-1" id="pact-login-title">Connexion</h2>
                        <p class="text-muted small" id="pact-login-subtitle">Accédez à votre compte PACTDIGITAL-BF</p>
                    </div>

                    <!-- Contenu Moodle du formulaire -->
                    <div class="login-wrapper">
                        <div class="login-container">
                            {{{ output.main_content }}}
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
(function() {
    var isSignup = (window.location.pathname.indexOf('/signup.php') !== -1);
    if (isSignup) {
        var t = document.getElementById('pact-login-title');
        var s = document.getElementById('pact-login-subtitle');
        if (t) t.textContent = 'Inscription';
        if (s) s.textContent = 'Créez votre compte citoyen PACTDIGITAL-BF';
        // Redirection vers la page d'inscription avec e-mail facultatif
        window.location.replace('/local/pactdigital/signup.php');
    }
})();
</script>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
