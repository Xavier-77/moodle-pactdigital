{{!
    @template theme_pactdigital/frontpage
    Vitrine d'accueil moderne inspirée d'Udemy pour PACTDIGITAL-BF
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block pact-udemy-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <!-- ── BANDEAU D'IDENTIFICATION OFFICIELLE & FILET NATIONAL (CHARTE V2.0) ── -->
    <div class="fs-officiel">
        <div class="fs-conteneur">
            <span class="fs-officiel-sceau">Site officiel de l'administration burkinabè</span>
            <span class="fs-masque-mobile">MTDPCE — Domaine officiel <code>gov.bf</code></span>
        </div>
    </div>
    <div class="fs-filet"></div>

    <!-- ── EN-TÊTE INSTITUTIONNEL PACTDIGITAL-BF ───────────────────────────── -->
    <header class="pact-udemy-navbar fs-entete">
        <div class="pact-udemy-nav-inner">
            <!-- Bloc-marque officiel (.fs-marque) -->
            <a href="{{{ urls.catalogue }}}" class="fs-marque pact-nav-brand">
                {{#armoiries_url}}
                    <img src="{{armoiries_url}}" alt="Armoiries du Burkina Faso" class="pact-nav-flag" height="52" style="height: 52px; width: auto;">
                {{/armoiries_url}}
                {{^armoiries_url}}
                    <img src="{{{ config.wwwroot }}}/theme/pactdigital/pix/armoiries.svg" alt="Armoiries du Burkina Faso" class="pact-nav-flag" height="52" style="height: 52px; width: auto;">
                {{/armoiries_url}}
                <span class="fs-marque-texte pact-nav-brand-text">
                    <span class="fs-marque-pays">Burkina Faso</span>
                    <span class="fs-marque-devise">La Patrie ou la Mort, nous Vaincrons</span>
                    <span class="fs-marque-entite pact-nav-ministry-title">MTDPCE — Plateforme Nationale PACTDIGITAL-BF</span>
                </span>
            </a>

            <!-- Liens directs & Actions -->
            <div class="pact-nav-actions">
                <a href="{{{ urls.verify }}}" class="pact-nav-link text-nowrap" title="Vérifier une attestation officielle">
                    Vérifier attestation
                </a>

                {{^is_logged_in}}
                    <a href="{{{ urls.login }}}" class="pact-btn pact-btn-outline">Se connecter</a>
                    <a href="{{{ urls.signup }}}" class="pact-btn pact-btn-primary">S'inscrire</a>
                {{/is_logged_in}}

                {{#is_logged_in}}
                    {{#is_trainer}}
                        <a href="{{{ urls.formateur }}}" class="pact-btn pact-btn-espace">Espace Formateur</a>
                    {{/is_trainer}}
                    {{^is_trainer}}
                        <a href="{{{ urls.apprenant }}}" class="pact-btn pact-btn-espace">Mon Espace</a>
                    {{/is_trainer}}
                    {{#is_manager}}
                        <a href="{{{ urls.management }}}" class="pact-btn pact-btn-outline">Gestion des cours</a>
                    {{/is_manager}}
                    <a href="{{{ urls.dashboard }}}" class="pact-btn pact-btn-outline">Tableau de bord</a>
                    <div class="pact-user-badge">
                        <span class="user-greeting">{{user_fullname}}</span>
                        <a href="{{{ urls.logout }}}" class="pact-logout-link" title="Se déconnecter">Déconnexion</a>
                    </div>
                {{/is_logged_in}}

            </div>
        </div>
    </header>

    <div id="page" class="pact-page-content">
        <div id="topofscroll" class="main-inner">
            <div id="page-content">
                <div id="region-main-box">
                    <div id="region-main">

                        <!-- ── 1. HERO BANNER : DESCRIPTION DU PROJET PACT DIGITAL ────────────── -->
                        <section class="pact-hero-section">
                            <div class="pact-hero-container">
                                <div class="pact-hero-card pact-hero-card-fullwidth">
                                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                        <span class="fs-repere"></span>
                                        <span class="pact-hero-badge mb-0">
                                            <span>Service public numérique — Projet Pact Digital</span>
                                        </span>
                                    </div>
                                    <h1 class="pact-hero-title">
                                        Projet PACTDIGITAL-BF : La formation aux compétences numériques au Burkina Faso
                                    </h1>
                                    <p class="pact-hero-subtitle">
                                        Porté par le <strong>Ministère de la Transition Digitale, des Postes et des Communications Électroniques</strong>, le projet <strong>PACTDIGITAL-BF</strong> est l'initiative nationale stratégique entièrement dédiée à la formation, au renforcement et à la certification des compétences numériques de l'ensemble de la population (citoyens, étudiants, professionnels et agents publics).
                                    </p>
                                    <p class="pact-hero-desc-lead">
                                        Ce projet met à disposition <strong>60 parcours de formation certifiants et gratuits</strong> couvrant 20 domaines essentiels du numérique (du niveau débutant Bronze au niveau expert Or). Chaque formation permet d'acquérir des compétences pratiques reconnues par l'État et de décrocher une <strong>attestation officielle avec QR Code de vérification</strong>.
                                    </p>

                                    <!-- CTA bouton épuré centré -->
                                    <div class="pact-hero-ctas justify-content-center text-center">
                                        <a href="{{{ urls.catalogue }}}" class="btn-hero-primary">
                                            Explorer les sessions de formation
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Motif tissé Faso Dan Fani en lisière du bandeau d'accueil -->
                        <div class="fs-tissage"></div>



                        <!-- ── 2. BARRE DE STATISTIQUES & RÉASSURANCE ─────────── -->
                        <section class="pact-stats-strip">
                            <div class="pact-stats-container">
                                <div class="pact-stat-item">
                                    <div class="stat-icon">🎓</div>
                                    <div class="stat-content">
                                        <div class="stat-number">{{stats.courses}}</div>
                                        <div class="stat-label">Formations en ligne</div>
                                    </div>
                                </div>
                                <div class="pact-stat-divider"></div>
                                <div class="pact-stat-item">
                                    <div class="stat-icon">🧭</div>
                                    <div class="stat-content">
                                        <div class="stat-number">{{stats.domains}}</div>
                                        <div class="stat-label">Domaines de compétences</div>
                                    </div>
                                </div>
                                <div class="pact-stat-divider"></div>
                                <div class="pact-stat-item">
                                    <div class="stat-icon">🥇</div>
                                    <div class="stat-content">
                                        <div class="stat-number">{{stats.levels}} Niveaux</div>
                                        <div class="stat-label">Bronze • Argent • Or</div>
                                    </div>
                                </div>
                                <div class="pact-stat-divider"></div>
                                <div class="pact-stat-item">
                                    <div class="stat-icon">🛡️</div>
                                    <div class="stat-content">
                                        <div class="stat-number">{{stats.free}}</div>
                                        <div class="stat-label">Attestation d'État QR Code</div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- ── 3. TOUTES LES COMPÉTENCES (ONGLETS STYLE UDEMY) ── -->
                        <section class="pact-skills-section">
                            <div class="pact-skills-container">
                                <div class="pact-section-header">
                                    <h2 class="pact-section-title">Toutes les compétences dont vous avez besoin au même endroit</h2>
                                    <p class="pact-section-sub">
                                        Du citoyen débutant au cadre dirigeant, choisissez votre niveau de certification et développez des compétences concrètes.
                                    </p>
                                </div>

                                <!-- Onglets horizontaux -->
                                <div class="pact-tabs-nav" role="tablist">
                                    {{#tabs}}
                                        <button class="pact-tab-btn {{#active}}active{{/active}}" data-target="{{target}}" role="tab">
                                            {{label}}
                                        </button>
                                    {{/tabs}}
                                </div>

                                <!-- Contenu des onglets -->
                                <div class="pact-tabs-content">
                                    {{#tabs}}
                                        <div id="{{target}}" class="pact-tab-pane {{#active}}active{{/active}}" role="tabpanel">
                                            <!-- Encart de présentation du pilier / onglet -->
                                            <div class="pact-tab-lead">
                                                <div class="tab-lead-text">
                                                    <h3 class="tab-lead-title">{{title}}</h3>
                                                    <p class="tab-lead-desc">{{desc}}</p>
                                                </div>
                                                <a href="{{explore_url}}" class="tab-lead-link">
                                                    {{explore_lbl}}
                                                </a>
                                            </div>

                                            <!-- Grille de cours façon Udemy -->
                                            <div class="pact-courses-grid">
                                                {{#courses}}
                                                    <div class="pact-course-card">
                                                        <a href="{{welcome_url}}" class="card-image-wrap">
                                                            {{#img_url}}
                                                                <img src="{{img_url}}" alt="{{title}}" class="card-img" loading="lazy">
                                                            {{/img_url}}
                                                            {{^img_url}}
                                                                <div class="card-img-placeholder" style="background: {{cat_color}}22;">
                                                                    <span class="placeholder-emoji"></span>
                                                                </div>
                                                            {{/img_url}}
                                                            <span class="card-level-badge {{level_cls}}">
                                                                {{level_label}}
                                                            </span>
                                                        </a>

                                                        <div class="card-body">
                                                            <div class="card-domain-row">
                                                                <span class="card-domain-tag">{{domain_name}}</span>
                                                            </div>
                                                            <h4 class="card-title">
                                                                <a href="{{welcome_url}}">{{title}}</a>
                                                            </h4>
                                                            <p class="card-summary">{{summary}}</p>
                                                            
                                                            <div class="card-features">
                                                                <span class="card-feature-pill">Attestation officielle</span>
                                                                <span class="card-feature-pill">2 voies au choix</span>
                                                            </div>

                                                            <div class="card-footer">
                                                                <div class="card-price">Gratuit</div>
                                                                <a href="{{welcome_url}}" class="btn-card-action">
                                                                    Découvrir
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {{/courses}}
                                            </div>

                                            <div class="pact-tab-bottom-cta text-center mt-4">
                                                <a href="{{explore_url}}" class="btn-view-all">
                                                    Voir toutes les formations de cette thématique
                                                </a>
                                            </div>
                                        </div>
                                    {{/tabs}}
                                </div>
                            </div>
                        </section>

                        <!-- ── 4. LES 4 GRANDS PILIERS DE FORMATION ────────────── -->
                        <section class="pact-pillars-section">
                            <div class="pact-pillars-container">
                                <div class="pact-section-header text-center">
                                    <h2 class="pact-section-title">Explorez par pilier national</h2>
                                    <p class="pact-section-sub">
                                        Les 60 cours du programme PACTDIGITAL-BF s'articulent autour de 4 piliers stratégiques pour le développement du Burkina Faso.
                                    </p>
                                </div>

                                <div class="pact-pillars-grid">
                                    {{#pillars}}
                                        <a href="{{url}}" class="pact-pillar-card" style="border-top-color: {{color}};">
                                            <div class="pillar-badge" style="background: {{color}}20; color: {{color}};">
                                                {{badge}}
                                            </div>
                                            <h3 class="pillar-title">{{name}}</h3>
                                            <p class="pillar-desc">{{desc}}</p>
                                            <span class="pillar-cta" style="color: {{color}};">
                                                Découvrir les cours
                                            </span>
                                        </a>
                                    {{/pillars}}
                                </div>
                            </div>
                        </section>

                        <!-- ── 5. POURQUOI CHOISIR PACTDIGITAL-BF ──────────────── -->
                        <section class="pact-why-section">
                            <div class="pact-why-container">
                                <div class="pact-section-header text-center">
                                    <h2 class="pact-section-title">Pourquoi apprendre sur PACTDIGITAL-BF ?</h2>
                                    <p class="pact-section-sub">
                                        Une plateforme moderne pensée pour la réussite et l'inclusion numérique de tous les Burkinabè.
                                    </p>
                                </div>

                                <div class="pact-features-grid">
                                    <div class="pact-feature-card">
                                        <div class="feature-icon-box">⚡</div>
                                        <h3 class="feature-title">Double voie d'évaluation</h3>
                                        <p class="feature-text">
                                            Suivez la <strong>Formation complète</strong> pas à pas avec vidéos et mémos, ou optez pour l'<strong>Examen direct</strong> pour valoriser immédiatement vos compétences.
                                        </p>
                                    </div>

                                    <div class="pact-feature-card">
                                        <div class="feature-icon-box">🎖️</div>
                                        <h3 class="feature-title">Attestation officielle infalsifiable</h3>
                                        <p class="feature-text">
                                            Chaque réussite génère un certificat PDF officiel du MTDPCE doté d'un numéro d'enregistrement unique et d'un <strong>QR Code vérifiable en ligne</strong>.
                                        </p>
                                    </div>

                                    <div class="pact-feature-card">
                                        <div class="feature-icon-box">📱</div>
                                        <h3 class="feature-title">Accessible sur tous les écrans</h3>
                                        <p class="feature-text">
                                            Apprenez sur smartphone, tablette ou ordinateur. Téléchargez les fiches mémos pour continuer à réviser même hors-ligne.
                                        </p>
                                    </div>

                                    <div class="pact-feature-card">
                                        <div class="feature-icon-box">🤝</div>
                                        <h3 class="feature-title">Réseau de formateurs certifiés</h3>
                                        <p class="feature-text">
                                            Bénéficiez d'ateliers en présentiel animés par des formateurs relais certifiés dans les 17 régions et 47 provinces du Burkina Faso.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- ── 6. ESPACE FORMATEUR & VÉRIFICATION D'ATTESTATION ── -->
                        <section class="pact-dual-cta-section">
                            <div class="pact-dual-container">
                                <!-- Encart Formateur -->
                                <div class="pact-cta-box trainer-box">
                                    <div class="box-content">
                                        <span class="box-tag">Réseau National</span>
                                        <h3 class="box-title">Vous êtes formateur ou animateur ?</h3>
                                        <p class="box-desc">
                                            Accédez à votre espace pédagogique pour piloter vos sessions, enregistrer les présences numériques et télécharger les guides d'animation officiels.
                                        </p>
                                        <a href="{{{ urls.formateur }}}" class="btn-box-action">
                                            Accéder à l'Espace Formateur
                                        </a>
                                    </div>
                                </div>

                                <!-- Encart Vérification Attestation -->
                                <div class="pact-cta-box verify-box">
                                    <div class="box-content">
                                        <span class="box-tag">Employeurs & Recruteurs</span>
                                        <h3 class="box-title">Vérifier l'authenticité d'une attestation</h3>
                                        <p class="box-desc">
                                            Contrôlez instantanément la validité d'un certificat PACTDIGITAL-BF présenté par un candidat grâce au code à 10 caractères ou au QR Code.
                                        </p>
                                        <form action="{{{ urls.verify }}}" method="GET" class="verify-quick-form">
                                            <input type="text" name="code" class="verify-input" placeholder="Ex : IWHZ4Smehu" required>
                                            <button type="submit" class="verify-submit-btn">Vérifier</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </section>


                        <div class="site-announcements-wrapper {{^has_announcements}}{{^is_editing}}d-none{{/is_editing}}{{/has_announcements}}">
                            {{{ output.main_content }}}
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 7. FOOTER INSTITUTIONNEL PACTDIGITAL-BF (CONFORME CHARTE V2.0) ──── -->
    <footer class="pact-udemy-footer fs-pied">
        <div class="fs-tissage" style="--tissage-fond: var(--surface-enfoncee);"></div>
        <div class="footer-top">
            <div class="footer-container">
                <div class="footer-col brand-col">
                    <a href="{{{ config.wwwroot }}}" class="fs-marque footer-brand" style="padding: 0;">
                        {{#armoiries_url}}
                            <img src="{{armoiries_url}}" alt="Armoiries du Burkina Faso" class="footer-flag">
                        {{/armoiries_url}}
                        {{^armoiries_url}}
                            <img src="{{{ config.wwwroot }}}/theme/pactdigital/pix/armoiries.svg" alt="Armoiries du Burkina Faso" class="footer-flag">
                        {{/armoiries_url}}
                        <span class="fs-marque-texte">
                            <span class="fs-marque-pays footer-country">Burkina Faso</span>
                            <span class="fs-marque-devise">La Patrie ou la Mort, nous Vaincrons</span>
                            <span class="fs-marque-entite footer-ministry">Ministère de la Transition Digitale, des Postes et des Communications Électroniques</span>
                        </span>
                    </a>
                    <p class="footer-about">
                        PACTDIGITAL-BF est la plateforme nationale de renforcement des compétences numériques portée par la Direction Générale de la Transition Digitale (DGTD).
                    </p>
                </div>

                <div class="footer-col">
                    <h4 class="footer-col-title">Navigation</h4>
                    <ul class="footer-links">
                        <li><a href="{{{ urls.catalogue }}}">Catalogue des 60 cours</a></li>
                        <li><a href="{{{ urls.catalogue }}}?domain=fondamentales">Compétences Fondamentales</a></li>
                        <li><a href="{{{ urls.catalogue }}}?domain=manageriales">Compétences Managériales</a></li>
                        <li><a href="{{{ urls.catalogue }}}?domain=sectorielles">Compétences Sectorielles</a></li>
                        <li><a href="{{{ urls.catalogue }}}?domain=emergentes">Technologies Émergentes</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-col-title">Services & Outils</h4>
                    <ul class="footer-links">
                        <li><a href="{{{ urls.verify }}}">Vérification d'attestation</a></li>
                        <li><a href="{{{ urls.apprenant }}}">Mon Espace Apprenant</a></li>
                        <li><a href="{{{ urls.formateur }}}">Espace Formateur</a></li>
                        <li><a href="{{{ urls.signup }}}">Créer un compte</a></li>
                        <li><a href="{{{ urls.login }}}">Se connecter</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-col-title">Cadre Légal & Support</h4>
                    <p class="footer-legal-note">
                        Plateforme conforme à la <strong>Loi n°001-2021/AN</strong> portant protection des données à caractère personnel et à la <strong>Charte graphique v2.0</strong> des services numériques de l'État burkinabè.
                    </p>
                    <div class="footer-badge-pact">
                        🇧🇫 La Patrie ou la Mort, nous Vaincrons
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-inner">
                <div>© 2026 PACTDIGITAL-BF — Service officiel de l'administration burkinabè.</div>
                <div class="footer-bottom-links">
                    <a href="{{{ urls.verify }}}">Vérification QR Code</a>
                    <span>•</span>
                    <a href="{{{ urls.catalogue }}}">Catalogue officiel</a>
                </div>
            </div>
        </div>
    </footer>

</div>

<!-- Script interactif léger pour la commutation des onglets -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var tabBtns = document.querySelectorAll('.pact-tab-btn');
    var tabPanes = document.querySelectorAll('.pact-tab-pane');

    tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var targetId = this.getAttribute('data-target');

            tabBtns.forEach(function(b) { b.classList.remove('active'); });
            tabPanes.forEach(function(p) { p.classList.remove('active'); });

            this.classList.add('active');
            var targetPane = document.getElementById(targetId);
            if (targetPane) {
                targetPane.classList.add('active');
            }
        });
    });
});
</script>

</body>
</html>
