<script>
let isCoursesExpanded = false;
const MAX_VISIBLE_COURSES = 5;

function updateCoursesVisibility() {
    const q = (document.getElementById('pact-student-search')?.value || '').toLowerCase().trim();
    const status = document.getElementById('pact-student-filter-status')?.value || 'all';
    const rows = document.querySelectorAll('#studentCoursesTable .course-row');
    const wrap = document.getElementById('pact-course-pagination-wrap');
    const btn = document.getElementById('btn-toggle-courses');

    let matchingRows = [];
    rows.forEach(row => {
        const name = (row.getAttribute('data-name') || '').toLowerCase();
        const rStatus = row.getAttribute('data-status') || '';

        const matchQuery = name.includes(q);
        const matchStatus = (status === 'all') || (rStatus === status);

        if (matchQuery && matchStatus) {
            matchingRows.push(row);
        } else {
            row.style.display = 'none';
        }
    });

    const isFiltering = (q !== '' || status !== 'all');
    if (isFiltering || matchingRows.length <= MAX_VISIBLE_COURSES) {
        if (wrap) wrap.style.display = 'none';
        matchingRows.forEach(row => row.style.display = '');
    } else {
        if (wrap) wrap.style.display = 'block';
        matchingRows.forEach((row, index) => {
            if (isCoursesExpanded || index < MAX_VISIBLE_COURSES) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        if (btn) {
            if (isCoursesExpanded) {
                btn.innerHTML = '▲ Réduire et afficher seulement 5 formations';
            } else {
                btn.innerHTML = '▾ Voir plus de formations (' + (matchingRows.length - MAX_VISIBLE_COURSES) + ' de plus)';
            }
        }
    }
}

function toggleStudentCourses() {
    isCoursesExpanded = !isCoursesExpanded;
    updateCoursesVisibility();
}

function filterStudentCourses() {
    isCoursesExpanded = false;
    updateCoursesVisibility();
}

// Initialisation dès le chargement du DOM
document.addEventListener('DOMContentLoaded', function() {
    updateCoursesVisibility();
});
setTimeout(updateCoursesVisibility, 300);

// Filtrage des étudiants pour l'enseignant
function filterTeacherStudents() {
    const q = (document.getElementById('pact-teacher-search')?.value || '').toLowerCase();
    const rows = document.querySelectorAll('#teacherStudentsTable .teacher-student-row');

    rows.forEach(row => {
        const name = (row.getAttribute('data-name') || '').toLowerCase();
        const email = (row.getAttribute('data-email') || '').toLowerCase();

        if (name.includes(q) || email.includes(q)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>

</body>
