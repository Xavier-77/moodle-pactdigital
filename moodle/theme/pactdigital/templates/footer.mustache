{{!
    @template theme_pactdigital/footer
}}
<footer id="page-footer" class="fs-pied pact-standard-footer mt-5">
    <div class="fs-tissage" style="--tissage-fond: var(--surface-enfoncee);"></div>
    <div class="container py-5">
        <div class="row g-4">
            <!-- Colonne 1 : Bloc-marque officiel (.fs-marque) -->
            <div class="col-lg-4 col-md-6">
                <a href="{{{ config.wwwroot }}}" class="fs-marque mb-3" style="padding: 0;">
                    <img src="{{{ config.wwwroot }}}/theme/pactdigital/pix/armoiries.svg" alt="Armoiries du Burkina Faso" style="height: 44px; width: auto;">
                    <span class="fs-marque-texte">
                        <span class="fs-marque-pays">Burkina Faso</span>
                        <span class="fs-marque-devise">La Patrie ou la Mort, nous Vaincrons</span>
                        <span class="fs-marque-entite">MTDPCE — PACTDIGITAL-BF</span>
                    </span>
                </a>
                <p class="fs-legende mt-2">Plateforme nationale de développement et de certification des compétences numériques du Burkina Faso.</p>
            </div>

            <!-- Colonne 2 : Liens rapides -->
            <div class="col-lg-4 col-md-6">
                <p class="fs-pied-titre">Liens rapides</p>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="{{{ config.wwwroot }}}">Accueil</a></li>
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/catalogue.php">📚 Catalogue des formations</a></li>
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/signup.php">Créer un compte</a></li>
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/verify.php">🔍 Vérifier une attestation</a></li>
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/faq.php">❓ Foire Aux Questions (FAQ)</a></li>
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/legal.php">⚖️ Mentions Légales &amp; Confidentialité</a></li>
                    {{# output.page_doc_link }}
                        <li><span>{{{ output.page_doc_link }}}</span></li>
                    {{/ output.page_doc_link }}
                </ul>
            </div>

            <!-- Colonne 3 : Contact & Support -->
            <div class="col-lg-4 col-md-12">
                <p class="fs-pied-titre">Assistance &amp; Support</p>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="{{{ config.wwwroot }}}/local/pactdigital/contact.php">💬 Formulaire de Contact &amp; Ticket</a></li>
                    <li><span class="fw-bold" style="color: var(--ocre-700, #7d5500);">📞 Numéro vert gratuit : 34 34</span></li>
                    <li><span class="fs-legende">✉️ support@pactdigital.bf</span></li>
                    {{# output.supportemail }}
                        <li><span class="fs-legende">{{{ output.supportemail }}}</span></li>
                    {{/ output.supportemail }}
                    {{# output.services_support_link }}
                        <li><span class="fs-legende">{{{ output.services_support_link }}}</span></li>
                    {{/ output.services_support_link }}
                </ul>
                <div class="mt-3 logininfo fs-legende small">
                    {{{ output.login_info }}}
                </div>
            </div>
        </div>

        <div class="fs-pied-bas mt-4">
            <div>
                &copy; {{# str }} copyright, core {{/ str }} PACTDIGITAL-BF — Service officiel de l'administration burkinabè (Charte v2.0).
                <div class="mt-1">{{{ output.standard_footer_html }}}</div>
            </div>
            <div class="text-md-end">
                <div>{{#str}}poweredbymoodle, core{{/str}}</div>
                {{#output.moodle_release}}
                    <div>
                        {{#str}}version, core{{/str}} {{{ output.moodle_release }}}
                    </div>
                {{/output.moodle_release}}
            </div>
        </div>
    </div>

    <!-- Moodle debug & end of body content -->
    <div class="tool_usertours-resettourcontainer"></div>
    {{{ output.standard_end_of_body_html }}}
    <div class="footer-content-debugging mt-3">
        <div class="container-fluid text-muted small">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>

<script>
(function() {
    // Si l'utilisateur est sur la page standard /course/index.php, ajouter un bandeau invitant au Catalogue
    const tree = document.querySelector('#page-course-index-category .course_category_tree');
    if (tree && !document.getElementById('pact-legacy-catalogue-banner')) {
        const banner = document.createElement('div');
        banner.id = 'pact-legacy-catalogue-banner';
        banner.style.cssText = 'background: linear-gradient(135deg, var(--vert-700, #045527), var(--vert-500, #00843b)); color: white; padding: 1.5rem 2rem; border-radius: 16px; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; box-shadow: 0 4px 20px rgba(0,132,59,0.22);';
        banner.innerHTML = `
            <div>
                <h3 style="margin:0 0 0.3rem; font-size:1.3rem; font-weight:800; color:white; font-family: var(--police-titre);">📚 Catalogue Officiel PACTDIGITAL-BF</h3>
                <p style="margin:0; opacity:0.92; font-size:0.95rem;">Explorez nos formations avec filtres par domaine, badges Bronze/Argent/Or et recherche instantanée.</p>
            </div>
            <a href="/local/pactdigital/catalogue.php" style="background:var(--or-300, #ffed00); color:var(--neutre-900, #211d1a); font-family:var(--police-titre); font-weight:700; padding:0.7rem 1.6rem; border-radius:8px; text-decoration:none; white-space:nowrap; box-shadow:0 3px 10px rgba(33,29,26,0.2); transition:transform 0.2s;">
                🎯 Découvrir le Catalogue ➔
            </a>
        `;
        tree.parentNode.insertBefore(banner, tree);
    }
})();
</script>
