        <div class="container-fluid text-muted small">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>

<script>
(function() {
    // Si l'utilisateur est sur la page standard /course/index.php, ajouter un bandeau invitant au Catalogue Netflix
    const tree = document.querySelector('#page-course-index-category .course_category_tree');
    if (tree && !document.getElementById('pact-legacy-catalogue-banner')) {
        const banner = document.createElement('div');
        banner.id = 'pact-legacy-catalogue-banner';
        banner.style.cssText = 'background: linear-gradient(135deg, #129b40, #0d7a32); color: white; padding: 1.5rem 2rem; border-radius: 16px; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; box-shadow: 0 4px 20px rgba(18,155,64,0.25);';
        banner.innerHTML = `
            <div>
                <h3 style="margin:0 0 0.3rem; font-size:1.3rem; font-weight:800; color:white;">📚 Nouveau Catalogue Immersif PACTDIGITAL-BF</h3>
                <p style="margin:0; opacity:0.9; font-size:0.95rem;">Explorez nos 57 formations avec filtres par domaine, badges Bronze/Argent/Or et recherche instantanée.</p>
            </div>
            <a href="/local/pactdigital/catalogue.php" style="background:#fad615; color:#1a1a1a; font-weight:800; padding:0.7rem 1.6rem; border-radius:50px; text-decoration:none; white-space:nowrap; box-shadow:0 3px 10px rgba(0,0,0,0.2); transition:transform 0.2s;">
                🎯 Découvrir le Catalogue ➔
            </a>
        `;
        tree.parentNode.insertBefore(banner, tree);
    }
})();
</script>
